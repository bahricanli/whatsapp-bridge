{
    "name": "bahricanli/whatsapp-bridge",
    "description": "Laravel notification channel for WhatsApp via Baileys Bridge",
    "homepage": "https://github.com/bahricanli/whatsapp-bridge",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bahri Meriç Canlı",
            "email": "bahri@bahri.info",
            "homepage": "https://www.bahri.info",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^6.5|^7.0",
        "illuminate/notifications": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\WhatsAppBridge\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\WhatsAppBridge\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\WhatsAppBridge\\WhatsAppServiceProvider"
            ],
            "aliases": {
                "WhatsApp": "NotificationChannels\\WhatsAppBridge\\WhatsAppFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
